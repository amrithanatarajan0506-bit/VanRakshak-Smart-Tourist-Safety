# Copy to .env and set unique values before starting the API.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate FERNET_KEY with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_URL=sqlite+aiosqlite:///./vanrakshak.db
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
FERNET_KEY=replace-with-a-generated-44-character-fernet-key
# Development-only defaults. Replace both before deploying to production.
STAFF_USERNAME=vanrakshak
STAFF_PASSWORD=Vanrakshak@123